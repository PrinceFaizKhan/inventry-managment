{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["Modules/Core/Resources/js/*"],
      "@core/*": ["Modules/Core/Resources/js/*"],
      "@admin/*": ["Modules/Admin/Resources/js/*"]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "Modules/**/Resources/js/**/*.ts",
    "Modules/**/Resources/js/**/*.vue"
  ]
}
